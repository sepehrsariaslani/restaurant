{
  "doctype": "DocType",
  "name": "Restaurant Customer Meal Plan Item",
  "module": "Restaurant",
  "istable": 1,
  "engine": "InnoDB",
  "field_order": ["meal_slot", "source_type", "item_code", "qty", "customization_json", "manual_name", "manual_quantity", "manual_kcal_known", "manual_protein_known", "manual_nutrition_complete", "kcal", "protein_g", "carb_g", "fat_g"],
  "fields": [
    {"fieldname":"meal_slot","fieldtype":"Select","label":"وعده","options":"صبحانه\nمیان‌وعده\nناهار\nشام","reqd":1,"in_list_view":1},
    {"fieldname":"source_type","fieldtype":"Select","label":"نوع قلم","options":"وی‌درخت\nثبت دستی","reqd":1},
    {"fieldname":"item_code","fieldtype":"Link","options":"Item","label":"محصول وی‌درخت"},
    {"fieldname":"qty","fieldtype":"Float","label":"تعداد","default":"1"},
    {"fieldname":"customization_json","fieldtype":"Long Text","label":"سفارشی‌سازی (JSON)"},
    {"fieldname":"manual_name","fieldtype":"Data","label":"نام خوراک دستی"},
    {"fieldname":"manual_quantity","fieldtype":"Data","label":"مقدار خوراک دستی"},
    {"fieldname":"manual_kcal_known","fieldtype":"Check","label":"کالری خوراک دستی ثبت شده است","default":"0"},
    {"fieldname":"manual_protein_known","fieldtype":"Check","label":"پروتئین خوراک دستی ثبت شده است","default":"0"},
    {"fieldname":"manual_nutrition_complete","fieldtype":"Check","label":"کالری و پروتئین ثبت شده‌اند","default":"0"},
    {"fieldname":"kcal","fieldtype":"Float","label":"کالری"},
    {"fieldname":"protein_g","fieldtype":"Float","label":"پروتئین (گرم)"},
    {"fieldname":"carb_g","fieldtype":"Float","label":"کربوهیدرات (گرم)"},
    {"fieldname":"fat_g","fieldtype":"Float","label":"چربی (گرم)"}
  ],
  "permissions": []
}
