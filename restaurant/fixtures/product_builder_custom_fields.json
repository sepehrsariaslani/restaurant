[
  {
    "doctype": "Custom Field",
    "name": "Item-restaurant_is_customizable",
    "module": "Restaurant",
    "dt": "Item",
    "fieldname": "restaurant_is_customizable",
    "fieldtype": "Check",
    "insert_after": "item_group",
    "label": "Is Customizable",
    "default": "0",
    "description": "Product can be customized via Product Builder"
  },
  {
    "doctype": "Custom Field",
    "name": "Item-restaurant_builder_template",
    "module": "Restaurant",
    "dt": "Item",
    "fieldname": "restaurant_builder_template",
    "fieldtype": "Link",
    "insert_after": "restaurant_is_customizable",
    "label": "Builder Template",
    "options": "Product Builder Template",
    "depends_on": "eval:doc.restaurant_is_customizable==1",
    "mandatory_depends_on": "eval:doc.restaurant_is_customizable==1"
  },
  {
    "doctype": "Custom Field",
    "name": "Item-restaurant_customize_button_label",
    "module": "Restaurant",
    "dt": "Item",
    "fieldname": "restaurant_customize_button_label",
    "fieldtype": "Data",
