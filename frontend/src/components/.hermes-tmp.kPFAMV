    font-size: 2.125rem;
  }
}

.sheet-panel {
  width: min(860px, 100%);
  max-height: calc(100dvh - 1rem);
  max-height: calc(100svh - 1rem);
  border-radius: 30px 30px 0 0;
  padding: 0 0 1.5rem;
  background: var(--pos-surface-color, #ffffff);
  box-shadow: 0 -12px 48px rgba(0, 0, 0, 0.10);
