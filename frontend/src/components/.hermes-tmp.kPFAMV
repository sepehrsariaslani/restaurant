}

.qty-btn:active {
  transform: scale(0.93);
}

.qty-plus {
  background: var(--accent-orange);
  color: #ffffff;
}

.qty-minus {
  background: var(--accent-orange);
  color: #ffffff;
}

.qty-number {
  font-size: 1.6rem;
  font-weight: 800;
  color: var(--accent-green);
  font-variant-numeric: tabular-nums;
  min-width: 32px;
  text-align: center;
  letter-spacing: -0.02em;
}

.hint {
  margin: 0;
