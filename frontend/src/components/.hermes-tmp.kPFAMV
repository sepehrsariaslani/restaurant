  letter-spacing: -0.02em;
  line-height: 1.15;
}

.footer-actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex: 1;
  justify-content: flex-end;
}

.footer-qty-controls {
  display: flex;
  align-items: center;
